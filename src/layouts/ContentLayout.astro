---
import TagList from "@components/TagList.astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "@lib/content";

interface Props {
  title: string;
  summary: string;
  date: Date;
  tags?: string[];
  section: string;
  minutes?: string;
}

const { title, summary, date, tags = [], section, minutes } = Astro.props;
---

<BaseLayout title={title} description={summary}>
  <article class="content-page" data-pagefind-body>
    <a class="back-link" href={`/${section}/`}>Back to {section}</a>
    <header>
      <p class="eyebrow">{section}</p>
      <h1>{title}</h1>
      <p>{summary}</p>
      <div class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {minutes && <span>{minutes}</span>}
      </div>
      <TagList tags={tags} />
    </header>
    <div class="content-prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .content-page {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 3rem);
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 2rem;
    color: var(--mint-strong);
    font-size: 0.9rem;
  }

  header {
    margin-bottom: 2.4rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2rem;
  }

  header p {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  h1 {
    max-width: 12ch;
    margin: 0.5rem 0 0.9rem;
    color: var(--text);
    font-size: clamp(2.5rem, 7vw, 5.8rem);
    letter-spacing: 0;
    line-height: 0.93;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin: 1rem 0;
    color: var(--subtle);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    h1 {
      max-width: none;
    }
  }
</style>
