---
import { type Project } from "@lib/content";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const stack = project.data.stack.slice(0, 4);
---

<article class:list={["project-card", { featured: project.data.featured }]}>
  <a
    href={`/projects/${project.slug}/`}
    aria-label={`Read project: ${project.data.title}`}
  >
    <header class="card-head">
      <h3>{project.data.title}</h3>
      {project.data.featured && <span class="badge">Featured</span>}
    </header>
    <p class="summary">{project.data.summary}</p>
    {
      stack.length > 0 && (
        <ul class="chips" aria-label="Tech stack">
          {stack.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    <footer class="card-foot">
      {
        project.data.github && (
          <span class="repo">
            <svg
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.34c-2.23.49-2.7-1.08-2.7-1.08-.36-.93-.9-1.18-.9-1.18-.73-.5.06-.49.06-.49.81.06 1.24.84 1.24.84.72 1.24 1.9.88 2.36.67.07-.52.28-.88.5-1.08-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            <span>{project.data.github.replace(/^https?:\/\/(www\.)?github\.com\//, "")}</span>
          </span>
        )
      }
      {
        typeof project.data.stars === "number" && (
          <span class="stars" aria-label={`${project.data.stars} stars`}>
            <svg
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M8 .25l2.36 4.78 5.27.77-3.81 3.72.9 5.25L8 12.27l-4.72 2.5.9-5.25L.37 5.8l5.27-.77L8 .25z" />
            </svg>
            <span>{project.data.stars}</span>
          </span>
        )
      }
    </footer>
  </a>
</article>

<style>
  .project-card {
    position: relative;
    min-height: 100%;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background:
      linear-gradient(135deg, rgba(142, 191, 175, 0.06), transparent 42%),
      rgba(17, 22, 20, 0.9);
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: rgba(142, 191, 175, 0.34);
  }

  .project-card.featured {
    border-color: rgba(216, 154, 99, 0.34);
  }

  a {
    display: grid;
    min-height: 100%;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.8rem;
    padding: 1.1rem 1.15rem;
  }

  .card-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  h3 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.1rem, 1rem + 0.35vw, 1.3rem);
    line-height: 1.2;
  }

  .badge {
    flex: 0 0 auto;
    border: 1px solid rgba(216, 154, 99, 0.45);
    border-radius: 999px;
    padding: 0.18rem 0.5rem;
    color: var(--copper);
    background: rgba(216, 154, 99, 0.1);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    border: 1px solid rgba(142, 191, 175, 0.2);
    border-radius: 999px;
    padding: 0.18rem 0.55rem;
    color: var(--mint-strong);
    background: rgba(142, 191, 175, 0.06);
    font-size: 0.72rem;
    line-height: 1.3;
  }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 0.75rem;
    color: var(--subtle);
    font-size: 0.78rem;
  }

  .repo,
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }

  .repo span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
