---
const navItems = [
  { href: "/", label: "Home", icon: "home" },
  { href: "/projects/", label: "Portfolio", icon: "briefcase" },
  { href: "/ideas/", label: "Ideas", icon: "bulb" },
  { href: "/notes/", label: "Notes", icon: "note" },
  { href: "/about/", label: "About", icon: "user" },
  { href: "mailto:hello@guilhermeoliveira.dev", label: "Contact", icon: "mail" },
];

const iconPaths: Record<string, string> = {
  home: "M2.5 7.3 8 2.8l5.5 4.5v6.2H9.7V9.8H6.3v3.7H2.5V7.3z",
  briefcase:
    "M5.2 4.8V3.2h5.6v1.6M2.4 5.2h11.2v8.1H2.4zM2.4 8.2h11.2",
  bulb: "M8 1.9a4.1 4.1 0 0 0-2.5 7.4c.5.4.8 1 .8 1.6h3.4c0-.6.3-1.2.8-1.6A4.1 4.1 0 0 0 8 1.9zM6.5 13.2h3M7 15h2M2.2 5.8H1M15 5.8h-1.2M3.5 2.3l-.8-.8M13.3 1.5l-.8.8",
  note: "M4 2.5h8v11H4zM6.2 5.6h3.7M6.2 8h3.7M6.2 10.4h2",
  user: "M12.6 14c0-2.3-2.1-4.1-4.6-4.1S3.4 11.7 3.4 14M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6z",
  mail: "M2.4 4.2h11.2v7.6H2.4zM2.8 4.7 8 8.6l5.2-3.9",
};

const currentPath = Astro.url.pathname;
---

<aside class="sidebar" aria-label="Primary">
  <div class="sidebar-top">
    <a class="identity" href="/" aria-label="Guilherme Oliveira home">
      <strong>Guilherme<br />Oliveira</strong>
      <small>Software engineer</small>
    </a>

    <nav class="nav">
      {
        navItems.map((item) => {
          const isRoute = item.href.startsWith("/");
          const isActive = isRoute
            ? item.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(item.href)
            : false;

          return (
            <a class:list={["nav-link", { active: isActive }]} href={item.href}>
              <svg
                width="18"
                height="18"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.35"
                aria-hidden="true"
              >
                <path d={iconPaths[item.icon]}></path>
              </svg>
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>
  </div>

  <div class="sidebar-foot">
    <p class="remote-status">
      <span aria-hidden="true"></span>
      <span>Working remotely<br />from Porto Alegre, Brazil</span>
    </p>

    <div class="time-block">
      <p class="clock" id="sidebar-clock" aria-label="Current time">--:--</p>
      <p>Local time</p>
    </div>

    <ul class="socials" aria-label="Profiles">
      <li>
        <a
          href="https://github.com/guilhermedeoliveira"
          aria-label="GitHub"
          rel="me"
        >
          <svg
            width="25"
            height="25"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.34c-2.23.49-2.7-1.08-2.7-1.08-.36-.93-.9-1.18-.9-1.18-.73-.5.06-.49.06-.49.81.06 1.24.84 1.24.84.72 1.24 1.9.88 2.36.67.07-.52.28-.88.5-1.08-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/in/guilhermedeoliveira"
          aria-label="LinkedIn"
          rel="me"
        >
          <svg
            width="25"
            height="25"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M3.63 5.33H.86V16h2.77V5.33zM2.24 0C1.34 0 .75.6.75 1.39c0 .78.57 1.39 1.46 1.39h.02c.92 0 1.49-.61 1.49-1.39C3.7.6 3.15 0 2.24 0zM16 9.88c0-3.27-1.75-4.79-4.08-4.79-1.88 0-2.72 1.03-3.19 1.76V5.33H5.96c.04 1 .04 10.67.04 10.67h2.77v-5.96c0-.32.02-.64.12-.87.25-.64.82-1.31 1.78-1.31 1.26 0 1.76.96 1.76 2.36V16h2.77V9.88z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a href="mailto:hello@guilhermeoliveira.dev" aria-label="Email">
          <svg
            width="25"
            height="25"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-linejoin="round"
            stroke-width="1.1"
            aria-hidden="true"
          >
            <path d="M1.4 3.4h13.2v9.2H1.4z"></path>
            <path d="m1.9 4 6.1 4.8L14.1 4"></path>
          </svg>
        </a>
      </li>
    </ul>
  </div>
</aside>

<script is:inline>
  (function () {
    var el = document.getElementById("sidebar-clock");
    if (!el) return;
    var fmt = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone: "America/Recife",
    });
    var tick = function () {
      el.textContent = fmt.format(new Date());
    };
    tick();
    setInterval(tick, 30000);
  })();
</script>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid rgba(184, 199, 190, 0.14);
    padding: 2.75rem 2.5rem 2.65rem;
    background:
      linear-gradient(180deg, rgba(13, 21, 21, 0.84), rgba(9, 16, 16, 0.74)),
      rgba(7, 13, 13, 0.84);
    box-shadow: inset -18px 0 45px rgba(0, 0, 0, 0.12);
  }

  .sidebar-top {
    display: grid;
    gap: 2.35rem;
  }

  .identity {
    display: block;
    border-bottom: 1px solid rgba(184, 199, 190, 0.18);
    padding-bottom: 2.15rem;
  }

  .identity strong,
  .identity small {
    display: block;
  }

  .identity strong {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.18;
  }

  .identity small {
    margin-top: 0.55rem;
    color: var(--mint-strong);
    font-size: 0.86rem;
    line-height: 1.3;
  }

  .nav {
    display: grid;
    gap: 1.45rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.83rem;
    line-height: 1;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .nav-link svg {
    flex: 0 0 auto;
    color: currentColor;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--mint-strong);
  }

  .nav-link:hover {
    transform: translateX(2px);
  }

  .sidebar-foot {
    display: grid;
    gap: 1.95rem;
    color: var(--muted);
  }

  .remote-status {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    margin: 0;
    border-bottom: 1px solid rgba(184, 199, 190, 0.16);
    padding-bottom: 2rem;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .remote-status span:first-child {
    width: 0.42rem;
    height: 0.42rem;
    margin-top: 0.42rem;
    border-radius: 999px;
    background: var(--mint-strong);
    box-shadow: 0 0 18px rgba(147, 207, 154, 0.32);
  }

  .time-block {
    display: grid;
    gap: 0.48rem;
  }

  .clock {
    width: max-content;
    margin: 0;
    border: 1px solid rgba(214, 154, 72, 0.34);
    border-radius: 0.22rem;
    padding: 0.2rem 0.45rem;
    color: #f3b54d;
    background: rgba(214, 154, 72, 0.08);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.25;
  }

  .time-block p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .socials {
    display: flex;
    justify-content: space-between;
    gap: 1.45rem;
    width: 10.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .socials a:hover {
    color: var(--text);
    transform: translateY(-1px);
  }

  @media (max-width: 980px) {
    .sidebar {
      position: relative;
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid rgba(184, 199, 190, 0.14);
      padding: 1.1rem;
    }

    .sidebar-top {
      gap: 1rem;
    }

    .identity {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .identity strong {
      font-size: 1.6rem;
    }

    .identity strong br {
      display: none;
    }

    .nav {
      grid-template-columns: repeat(6, max-content);
      gap: 1rem;
      overflow-x: auto;
      padding-bottom: 0.15rem;
    }

    .nav-link {
      gap: 0.55rem;
      white-space: nowrap;
    }

    .sidebar-foot {
      display: none;
    }
  }
</style>
