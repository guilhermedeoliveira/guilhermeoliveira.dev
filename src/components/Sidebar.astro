---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Portfolio" },
  { href: "/notes/", label: "Notes" },
  { href: "/ideas/", label: "Ideas" },
  { href: "/about/", label: "About" },
];

const currentPath = Astro.url.pathname;
---

<aside class="sidebar" aria-label="Primary">
  <a class="identity" href="/" aria-label="Guilherme Oliveira home">
    <span class="mark">GO</span>
    <span>
      <strong>Guilherme Oliveira</strong>
      <small>Software engineer</small>
    </span>
  </a>

  <nav class="nav">
    {
      navItems.map((item) => {
        const isActive =
          item.href === "/"
            ? currentPath === "/"
            : currentPath.startsWith(item.href);

        return (
          <a class:list={["nav-link", { active: isActive }]} href={item.href}>
            <span>{item.label}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="sidebar-foot">
    <p class="clock" id="sidebar-clock" aria-label="Current time">--:--</p>
    <ul class="socials" aria-label="Profiles">
      <li>
        <a
          href="https://github.com/guilhermeoliveira"
          aria-label="GitHub"
          rel="me"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.34c-2.23.49-2.7-1.08-2.7-1.08-.36-.93-.9-1.18-.9-1.18-.73-.5.06-.49.06-.49.81.06 1.24.84 1.24.84.72 1.24 1.9.88 2.36.67.07-.52.28-.88.5-1.08-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href="https://twitter.com/guilhermeoliveira"
          aria-label="X / Twitter"
          rel="me"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12.4 1.5h2.34l-5.1 5.84L16 14.5h-4.7L7.6 9.66 3.4 14.5H1.06l5.46-6.24L0 1.5h4.82l3.34 4.42L12.4 1.5zm-.82 11.6h1.3L4.5 2.83H3.1l8.48 10.27z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a href="/rss.xml" aria-label="RSS feed">
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M2 2v2.4c5.3 0 9.6 4.3 9.6 9.6H14C14 7.4 8.6 2 2 2zm0 4.8v2.4a4.8 4.8 0 014.8 4.8h2.4A7.2 7.2 0 002 6.8zM3.5 11a1.5 1.5 0 100 3 1.5 1.5 0 000-3z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <a href="mailto:hello@guilhermeoliveira.dev" aria-label="Email">
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M1.5 3h13c.28 0 .5.22.5.5v9a.5.5 0 01-.5.5h-13a.5.5 0 01-.5-.5v-9c0-.28.22-.5.5-.5zm.5 1.84v7.66h12V4.84L8 9.5 2 4.84zm11.04-.84H2.96L8 7.92 13.04 4z"
            ></path>
          </svg>
        </a>
      </li>
    </ul>
    <p class="location">Berlin, mostly remote</p>
  </div>
</aside>

<script is:inline>
  (function () {
    var el = document.getElementById("sidebar-clock");
    if (!el) return;
    var fmt = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone: "Europe/Berlin",
    });
    var tick = function () {
      el.textContent = fmt.format(new Date());
    };
    tick();
    setInterval(tick, 30000);
  })();
</script>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    gap: 2rem;
    border-right: 1px solid var(--line);
    padding: 2rem 1.35rem;
    background: rgba(11, 15, 14, 0.76);
    backdrop-filter: blur(18px);
  }

  .identity {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
  }

  .mark {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(142, 191, 175, 0.28);
    border-radius: 0.7rem;
    color: var(--text);
    background: linear-gradient(
      135deg,
      rgba(142, 191, 175, 0.16),
      rgba(216, 154, 99, 0.12)
    );
    font-size: 0.78rem;
    font-weight: 800;
  }

  .identity strong,
  .identity small {
    display: block;
  }

  .identity strong {
    color: var(--text);
    font-size: 0.96rem;
    line-height: 1.2;
  }

  .identity small {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .nav {
    display: grid;
    gap: 0.35rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    min-height: 2.4rem;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    padding: 0 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    border-color: rgba(142, 191, 175, 0.18);
    color: var(--text);
    background: rgba(142, 191, 175, 0.08);
  }

  .sidebar-foot {
    display: grid;
    gap: 0.85rem;
    margin-top: auto;
    color: var(--muted);
  }

  .clock {
    margin: 0;
    color: var(--text);
    font-family:
      "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials a {
    display: inline-flex;
    width: 1.95rem;
    height: 1.95rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    color: var(--muted);
    background: rgba(17, 22, 20, 0.65);
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }

  .socials a:hover {
    border-color: rgba(142, 191, 175, 0.34);
    color: var(--text);
  }

  .location {
    margin: 0;
    color: var(--subtle);
    font-size: 0.78rem;
  }

  @media (max-width: 920px) {
    .sidebar {
      position: relative;
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 1rem;
    }

    .nav {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      overflow-x: auto;
    }

    .nav-link {
      justify-content: center;
      white-space: nowrap;
    }

    .sidebar-foot {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .nav {
      grid-template-columns: repeat(5, max-content);
      padding-bottom: 0.15rem;
    }
  }
</style>
