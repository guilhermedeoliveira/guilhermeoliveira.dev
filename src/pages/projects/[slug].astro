---
import TagList from "@components/TagList.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate, slugFromId } from "@lib/content";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: slugFromId(project.id) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="project-page" data-pagefind-body>
    <a class="back-link" href="/projects/">Back to projects</a>
    <header>
      <p class="eyebrow">Project</p>
      <h1>{project.data.title}</h1>
      <p>{project.data.summary}</p>
      <dl class="facts">
        <div>
          <dt>Date</dt>
          <dd>{formatDate(project.data.date)}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{project.data.status}</dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>{project.data.role}</dd>
        </div>
        {
          project.data.outcome && (
            <div>
              <dt>Outcome</dt>
              <dd>{project.data.outcome}</dd>
            </div>
          )
        }
      </dl>
      <TagList tags={project.data.stack} />
      {
        project.data.links.length > 0 && (
          <div class="links">
            {project.data.links.map((link) => (
              <a href={link.url}>{link.label}</a>
            ))}
          </div>
        )
      }
    </header>
    <div class="content-prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    max-width: 920px;
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 3rem);
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 2rem;
    color: var(--mint-strong);
    font-size: 0.9rem;
  }

  header {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.4rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2rem;
  }

  h1 {
    max-width: 22ch;
    margin: 0;
    color: var(--text);
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.1;
  }

  header > p {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 0;
  }

  .facts div {
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    padding: 0.8rem;
    background: rgba(17, 22, 20, 0.72);
  }

  dt {
    color: var(--subtle);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  dd {
    margin: 0.24rem 0 0;
    color: var(--text);
    line-height: 1.45;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .links a {
    border: 1px solid rgba(142, 191, 175, 0.28);
    border-radius: 0.7rem;
    padding: 0.55rem 0.8rem;
    color: var(--mint-strong);
    background: rgba(142, 191, 175, 0.06);
  }

  @media (max-width: 680px) {
    .facts {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: none;
    }
  }
</style>
