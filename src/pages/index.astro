---
import ProjectCard from "@components/ProjectCard.astro";
import RightRail from "@components/RightRail.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getNotes, getProjects } from "@lib/content";

const [projects, notes] = await Promise.all([
  getProjects(),
  getNotes(),
]);
const featuredProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<BaseLayout>
  <div class="home-grid">
    <section class="home-main" data-pagefind-body>
      <header class="hero">
        <p class="prompt" aria-hidden="true">&gt;_</p>
        <h1>Building reliable tools for real work</h1>
        <p class="tagline">Systems, automation, and thoughtful software</p>
        <div class="hero-actions" aria-label="Profile links">
          <a href="/about/">
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.35"
              aria-hidden="true"
            >
              <path d="M4 2.5h8v11H4zM6.2 5.8h3.6M6.2 8.2h3.6M6.2 10.6h2"></path>
            </svg>
            <span>View my resume</span>
          </a>
          <a href="https://github.com/guilhermedeoliveira">
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.35"
              aria-hidden="true"
            >
              <path d="m5.5 4-4 4 4 4M10.5 4l4 4-4 4"></path>
            </svg>
            <span>View on GitHub</span>
          </a>
        </div>
      </header>

      <section class="selected-work" aria-labelledby="selected-work-title">
        <div class="section-heading">
          <h2 id="selected-work-title">Selected work</h2>
        </div>
        <div class="project-grid">
          {
            featuredProjects.map((project, index) => (
              <ProjectCard
                project={project}
                variant={index}
                compactOptional={index > 3}
                showFeaturedBadge={index === 0}
              />
            ))
          }
        </div>
        <a class="section-link" href="/projects/">View all projects -></a>
      </section>
    </section>

    <RightRail notes={notes} />
  </div>
</BaseLayout>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(22rem, 26.6vw, 25.5rem);
    min-height: 100vh;
  }

  .home-main {
    min-width: 0;
    padding: clamp(2rem, 4vw, 2.85rem) clamp(2rem, 3.2vw, 2.4rem)
      clamp(2rem, 4vw, 2.85rem) clamp(2rem, 3.4vw, 2.85rem);
  }

  .hero {
    display: grid;
    gap: 0.78rem;
    max-width: 820px;
    padding: 0 0 2.25rem;
  }

  .prompt,
  .tagline {
    margin: 0;
  }

  .prompt {
    color: var(--mint-strong);
    font-size: 1.35rem;
    line-height: 1;
  }

  .hero h1 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(2.65rem, 3.35vw, 3.25rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.06;
  }

  .tagline {
    color: var(--muted);
    font-size: clamp(0.9rem, 0.82rem + 0.25vw, 1rem);
    letter-spacing: 0.03em;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 0.5rem;
  }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--mint-strong);
    font-size: 0.82rem;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .hero-actions a:hover {
    color: var(--text);
    transform: translateY(-1px);
  }

  .selected-work {
    border-top: 1px solid rgba(184, 199, 190, 0.18);
    padding-top: 1.75rem;
  }

  .section-heading {
    margin-bottom: 1.25rem;
  }

  .section-heading h2 {
    margin: 0;
  }

  .section-heading h2 {
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 1.25rem + 1vw, 2rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .section-link {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--mint-strong);
    font-size: 0.82rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 1.35rem;
  }

  @media (max-width: 1220px) {
    .home-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 981px) and (max-width: 1380px) and (max-height: 860px) {
    .home-main {
      padding: 2.1rem 2.35rem 1.8rem 2.75rem;
    }

    .hero {
      gap: 0.56rem;
      padding-bottom: 1.45rem;
    }

    .prompt {
      font-size: 1.25rem;
    }

    .hero h1 {
      font-size: clamp(2.25rem, 3.1vw, 2.82rem);
      line-height: 1.02;
    }

    .tagline {
      line-height: 1.45;
    }

    .hero-actions {
      margin-top: 0.2rem;
    }

    .selected-work {
      padding-top: 1.4rem;
    }

    .section-heading {
      margin-bottom: 1.05rem;
    }

    .project-grid {
      gap: 1rem 1.2rem;
    }

    .section-link {
      margin-top: 1rem;
    }
  }

  @media (max-width: 760px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: none;
    }
  }
</style>
