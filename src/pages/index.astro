---
import ProjectCard from "@components/ProjectCard.astro";
import RightRail from "@components/RightRail.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getNotes, getProjects } from "@lib/content";

const [projects, notes] = await Promise.all([
  getProjects(),
  getNotes(),
]);
const featuredProjects = projects
  .filter((project) => project.data.featured)
  .slice(0, 6);
---

<BaseLayout>
  <div class="home-grid">
    <section class="home-main" data-pagefind-body>
      <header class="hero">
        <p class="eyebrow">Systems, automation, and thoughtful software</p>
        <h1>Building reliable tools for real work.</h1>
      </header>

      <section class="selected-work" aria-labelledby="selected-work-title">
        <div class="section-heading">
          <p class="eyebrow">Portfolio</p>
          <h2 id="selected-work-title">Selected work</h2>
        </div>
        <div class="project-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
        <a class="section-link" href="/projects/">View all projects</a>
      </section>
    </section>

    <RightRail notes={notes} />
  </div>
</BaseLayout>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    min-height: 100vh;
  }

  .home-main {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 3rem);
  }

  .hero {
    display: grid;
    gap: 0.6rem;
    max-width: 760px;
    padding: 1rem 0 2.4rem;
  }

  .hero h1 {
    max-width: 18ch;
    margin: 0;
    color: var(--text);
    font-size: clamp(2rem, 3.8vw, 3.4rem);
    letter-spacing: 0;
    line-height: 1.05;
  }

  .selected-work {
    border-top: 1px solid var(--line);
    padding-top: 1.4rem;
  }

  .section-heading {
    margin-bottom: 1rem;
  }

  .section-heading p,
  .section-heading h2 {
    margin: 0;
  }

  .section-heading h2 {
    margin-top: 0.25rem;
    color: var(--text);
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.35rem);
    line-height: 1;
  }

  .section-link {
    display: inline-block;
    margin-top: 1.4rem;
    color: var(--mint-strong);
    font-size: 0.9rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 1160px) {
    .home-grid {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: 12ch;
    }
  }

  @media (max-width: 760px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: none;
    }
  }
</style>
